-- --- ฟังก์ชันควบคุมทรัพยากร ---

-- 1. ลบแสงเงาและเอฟเฟกต์หนักๆ
createToggle("Disable Lighting FX", false, function(state)
	if state then
		Lighting.GlobalShadows = false
		Lighting.Brightness = 1
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") then
				v.Enabled = false
			end
		end
	else
		Lighting.GlobalShadows = true
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") then
				v.Enabled = true
			end
		end
	end
end)

-- 2. ปรับ Material เป็น Smooth / Plastic (ลดภาระ GPU)
createToggle("Potato Textures", false, function(state)
	for _, v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("BasePart") then
			if state then
				v.Material = Enum.Material.SmoothPlastic
				v.Reflectance = 0
			end
		end
	end
end)

-- 3. ปิดเสียงและเอฟเฟกต์พาร์ติเคิล
createToggle("Remove Particles & FX", false, function(state)
	for _, v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
			v.Enabled = not state
		end
	end
end)

-- 4. โหมด Super Low Graphics (ตัดสิ่งไม่จำเป็น แต่คงตัวละคร/NPC ไว้ครบ)
createToggle("Super Low Graphics", false, function(state)
	for _, v in ipairs(Workspace:GetDescendants()) do
		-- ตรวจสอบว่าเป็นสิ่งแวดล้อมชิ้นเล็กๆ หรือพืชพรรณรกตา
		if v:IsA("BasePart") then
			local isCharacter = v:IsDescendantOf(workspace) and (v.Parent:FindFirstChild("Humanoid") or v.Parent.Parent:FindFirstChild("Humanoid"))
			
			if not isCharacter then
				-- เช็คว่าเป็นพวกต้นไม้ พุ่มไม้ หรือของตกแต่งชิ้นเล็ก
				if v.Size.Magnitude < 15 and (v.Material == Enum.Material.Grass or v.Material == Enum.Material.LeafyGrass or v.Name:lower():find("tree") or v.Name:lower():find("bush")) then
					v.Transparency = state and 1 or 0
					v.CanCollide = not state
				end
			end
		end
	end
end)
